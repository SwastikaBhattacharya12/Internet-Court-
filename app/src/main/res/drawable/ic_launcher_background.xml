<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Premium dark-mode black base -->
    <path
        android:pathData="M0,0 h108 v108 h-108 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:type="linear">
                <item android:offset="0.0" android:color="#0A0A0B" />
                <item android:offset="1.0" android:color="#141416" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Glowing Orange Ambient Halo (representing Courtroom Verdict power) -->
    <path
        android:pathData="M54,54 m-45,0 a45,45 0,1 1,90 0 a45,45 0,1 1,-90 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="45"
                android:type="radial">
                <item android:offset="0.0" android:color="#2FFF4D00" /> <!-- Hot orange glow -->
                <item android:offset="0.7" android:color="#08FF4D00" />
                <item android:offset="1.0" android:color="#00000000" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Ultra-subtle cyber grid pattern lines for modern internet metadata vibe -->
    <path
        android:fillColor="#00000000"
        android:pathData="M18,0 L18,108 M36,0 L36,108 M54,0 L54,108 M72,0 L72,108 M90,0 L90,108 M0,18 L108,18 M0,36 L108,36 M0,54 L108,54 M0,72 L108,72 M0,90 L108,90"
        android:strokeWidth="0.25"
        android:strokeColor="#1AFF4D00" />
